DB_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=flight_data_scrapper
POSTGRES_USER=postgres

# Set these to your real domains after DNS is configured.
CORS_ORIGINS=https://your-frontend-domain.com
ALLOWED_HOSTS=your-api-domain.com

# Required backend secrets.
# Generate JWT_SECRET_KEY with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-unique-admin-password
ADMIN_FULL_NAME=System Admin

# Keep scheduler enabled on the VPS unless you want manual-only collection.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60

# Primary provider: Scrape.do non-rendered /flights/poll JSON API (render=false, super=true).
# Leave SCRAPEDO_COUNTRY_CODE blank so each route group's market drives the KAYAK host and geoCode.
SCRAPEDO_API_KEY=replace-with-scrapedo-api-key
SCRAPEDO_API_KEYS=
SCRAPEDO_COUNTRY_CODE=
SCRAPEDO_SUPER_PROXY=true
SCRAPEDO_INITIAL_POLL_DELAY_SECONDS=45.0
SCRAPEDO_POLL_DELAY_SECONDS=15.0
SCRAPEDO_MAX_POLLS=1
SCRAPEDO_ALLOW_MULT_FALLBACK=false

# Optional fallback provider (used only when SCRAPEDO_API_KEY / SCRAPEDO_API_KEYS are empty).
SCRAPINGBEE_API_KEY=
SCRAPINGBEE_API_KEYS=
SCRAPINGBEE_COUNTRY_CODE=
SCRAPINGBEE_PREMIUM_PROXY=false
SCRAPINGBEE_STEALTH_PROXY=true
SCRAPINGBEE_MULTI_CITY_DEBUG=false
# Use the probe-validated direct results URL with stealth and extract_rules.
SCRAPINGBEE_KAYAK_HOMEPAGE_EXTRACT=false
# Stealth scenario wait is split into 10-second steps by the provider.
SCRAPINGBEE_KAYAK_RESULT_WAIT_MS=30000

# VPS tuning for Scrape.do /flights/poll (strict 20 cr/date at concurrency=8)
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_MAX_RETRIES=1
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=525600
PROVIDER_CONCURRENCY_LIMIT=8
PROVIDER_RENDERED_CONCURRENCY_LIMIT=1
PROVIDER_MIN_DELAY_SECONDS=1
SCRAPE_BATCH_SIZE=6
SCRAPE_ROUTE_PARALLELISM=3
SCRAPE_DELAY_SECONDS=1
SCRAPE_MAX_DAYS_AHEAD=325
